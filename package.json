{
  "name": "chronotope-of-quranic-reality",
  "private": true,
  "version": "0.1.0",
  "description": "Events narrated in the Quran on a timeline and a map, next to what history and archaeology know about the same periods and places.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "validate": "tsx scripts/validate.ts",
    "format:content": "tsx scripts/format-content.ts",
    "quran:fetch": "tsx scripts/quran-fetch.ts",
    "quran:verify": "tsx scripts/quran-verify.ts",
    "test": "node scripts/test.mjs run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tsconfig/svelte": "^5.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
